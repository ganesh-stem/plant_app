<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Verdant" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Verdant.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/forest</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_leaf</item>
        <item name="postSplashScreenTheme">@style/Theme.Verdant</item>
    </style>
</resources>
